    "turbo": "^2.4.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.8",
      "@types/react-dom": "19.1.5"
    }
  },
  "packageManager": "pnpm@10.3.0"
}
