POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=fomo
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg2://postgres:your-postgres-password@db:5432/fomo

N8N_WEBHOOK_URL=http://n8n:5678/webhook/scraper-finished

MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ---------------------------------------------------------------------------
# AI extraction (disabled by default — no cost in local/dev/CI)
# ---------------------------------------------------------------------------
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=disabled

# Staging/MVP: set AI_PROVIDER=deepseek and supply the API key.
# AI_PROVIDER=deepseek
# AI_API_KEY=your-deepseek-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key   # alias for AI_API_KEY

# Model and cost controls (adjust as needed):
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com
# AI_MAX_INPUT_CHARS=12000
# AI_MAX_OUTPUT_TOKENS=800
# AI_REQUEST_TIMEOUT_SECONDS=20

# Legacy Gemini provider (AI_PROVIDER=gemini only, not required for local/dev/CI):
# GOOGLE_API_KEY=your-google-api-key
