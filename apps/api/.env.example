# ---------------------------------------------------------------------------
# apps/api/.env.example — FastAPI service
# ---------------------------------------------------------------------------
# Copy to apps/api/.env.local (or apps/api/.env) for local dev.
# NEVER commit files containing real credentials.
# In Docker Compose, vars are injected from docker-compose.local.yml directly.
# This file is only needed when running the API process on your host machine
# (outside Docker), e.g. with: uv run uvicorn app.main:app --app-dir apps/api
# ---------------------------------------------------------------------------

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=debug
API_PORT=8000

# --- Database & Cache ---
# localhost refers to the Docker-hosted postgres/redis exposed on the host.
POSTGRES_USER=fomo
POSTGRES_PASSWORD=fomo_local_password
POSTGRES_DB=fomo
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://fomo:fomo_local_password@localhost:5432/fomo

# --- Application ---
SECRET_KEY=change-me-local-secret-key-min-32-chars
N8N_WEBHOOK_URL=http://localhost:5678/webhook/scraper-finished

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Comma-separated is preferred (works cleanly in Kubernetes ConfigMaps).
# JSON array also accepted: CORS_ALLOWED_ORIGINS=["https://...","http://..."]
# Do NOT use * — allow_credentials=True requires explicit origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Staging example:
# CORS_ALLOWED_ORIGINS=https://dashboard.staging.fomo-lab.org,http://localhost:3000

# --- Mapbox (server-side geocoding — optional for local) ---
# Only needed if you want geocoding to work locally. Leave blank to disable.
# MAPBOX_ACCESS_TOKEN=your-mapbox-secret-token-here

# ---------------------------------------------------------------------------
# AI extraction (disabled by default — no cost in local/dev/CI)
# ---------------------------------------------------------------------------
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=800
AI_REQUEST_TIMEOUT_SECONDS=20

# Staging/MVP: set AI_PROVIDER=deepseek and supply the key.
# AI_PROVIDER=deepseek
# AI_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_API_KEY=your-deepseek-api-key-here   # alias for AI_API_KEY

# Legacy Gemini provider (AI_PROVIDER=gemini only — not required for local/dev/CI):
# GOOGLE_API_KEY=your-google-api-key-here

# ---------------------------------------------------------------------------
# OIDC / Keycloak JWT authentication (disabled by default for local dev)
# ---------------------------------------------------------------------------
# Set AUTH_OIDC_ENABLED=true in staging/prod and supply the Keycloak realm URLs.
# When false, all require_authenticated_identity deps return HTTP 503.
AUTH_OIDC_ENABLED=false
# AUTH_OIDC_ISSUER=https://auth.staging.fomo-lab.org/realms/fomo
# AUTH_OIDC_JWKS_URL=https://auth.staging.fomo-lab.org/realms/fomo/protocol/openid-connect/certs
# AUTH_OIDC_CLIENT_ID=fomo-dashboard

# Comma-separated list of allowed azp (authorized party) values.
# azp is the Keycloak client that issued the token — more reliable than aud
# for public clients.  List every client that should be permitted to call the API.
# AUTH_OIDC_ALLOWED_AZP=fomo-dashboard,fomo-n8n-ingestion

# Comma-separated list of allowed audience (aud) values.
# Leave empty to skip audience validation (Keycloak public clients often omit
# the client_id from aud; prefer azp validation instead).
# AUTH_OIDC_ALLOWED_AUDIENCES=

# ---------------------------------------------------------------------------
# Keycloak Admin REST API — backend-only user management (FOMO-161)
# ---------------------------------------------------------------------------
# Required to enable the POST /admin/users/invite endpoint.
# Create a dedicated service-account client in Keycloak with the
# "manage-users" realm role.  All four vars must be set; any missing var
# disables admin-invite gracefully (returns HTTP 503) without affecting auth.
# NEVER expose these values to the browser or mobile clients.
# KEYCLOAK_ADMIN_BASE_URL=https://auth.staging.fomo-lab.org
# KEYCLOAK_ADMIN_REALM=fomo-admin
# KEYCLOAK_ADMIN_CLIENT_ID=fomo-admin-service-account
# KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-here
