# ---------------------------------------------------------------------------
# apps/harvester-dashboard/.env.example — Next.js dashboard
# ---------------------------------------------------------------------------
# Copy to apps/harvester-dashboard/.env.local for local dev.
# NEVER commit files containing real credentials.
# ---------------------------------------------------------------------------

# API base URL — point to your local or staging API.
# This MUST match the variable name read by lib/api.ts (NEXT_PUBLIC_API_URL, not BASE_URL).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Keycloak OIDC — all public values, safe to expose in the browser.
# Dashboard client uses Authorization Code + PKCE (no secret).
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.staging.fomo-lab.org
NEXT_PUBLIC_KEYCLOAK_REALM=fomo-admin
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=fomo-dashboard

# Mapbox public token (pk.*) — optional for local development.
# This token is client-side (browser-visible). Restrict it by domain in the
# Mapbox dashboard to prevent abuse if extracted from network traffic.
# For local dev: leave blank (map tiles will not load) or use a domain-restricted token.
# For staging/prod: Jenkins injects this via credential binding — do not hardcode.
# NEXT_PUBLIC_MAPBOX_TOKEN=your-domain-restricted-mapbox-public-token-here
