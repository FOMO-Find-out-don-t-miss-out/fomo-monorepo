# ---------------------------------------------------------------------------
# apps/mobile/.env.example — Expo / React Native
# ---------------------------------------------------------------------------
# Copy to apps/mobile/.env for local dev.
# NEVER commit files containing real credentials.
# ---------------------------------------------------------------------------

# Backend API base URL.
# Staging:   https://api.staging.fomo-lab.org
# Local dev: http://10.0.2.2:8000  (Android emulator)
#            http://localhost:8000  (iOS simulator / Expo Go)
EXPO_PUBLIC_API_URL=https://api.staging.fomo-lab.org

# Auth / Keycloak settings for OIDC login (Authorization Code + PKCE).
EXPO_PUBLIC_AUTH_URL=https://auth.staging.fomo-lab.org
EXPO_PUBLIC_KEYCLOAK_REALM=fomo-users
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=fomo-mobile
# Redirect scheme registered in app.json and in the Keycloak client.
# The redirect URI sent to Keycloak is: fomo://
EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=fomo

# Mapbox PUBLIC token (pk.*) for the in-app map.
# EXPO_PUBLIC_* vars are embedded at build time — treat this as client-visible.
# Restrict this token by bundle ID in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-pk-token-here

# Note: the Mapbox *secret* token (sk.*) used by Gradle to download the Maps SDK
# must be placed in your local ~/.gradle/gradle.properties as:
#   MAPBOX_DOWNLOADS_TOKEN=sk.your-secret-token-here
# Never put the sk.* token here or in any tracked file.

# Default discovery coordinates used until expo-location + permission flow is implemented.
# These are read at app startup and passed to GET /api/v1/events/discovery.
# Staging default: central Athens (most current events are Greece/More.com sources).
# Change to your city when testing locally.
EXPO_PUBLIC_DEFAULT_LAT=37.9838
EXPO_PUBLIC_DEFAULT_LNG=23.7275
EXPO_PUBLIC_DEFAULT_RADIUS_KM=50

# FOMO-174 performance instrumentation (dev-only; see docs/mobile/mobile-performance-baseline.md)
EXPO_PUBLIC_PERF_DEBUG=false
# Render-counter logging only (heavier observer overhead — keep OFF during
# timing benchmark runs; see docs/mobile/mobile-performance-baseline.md)
EXPO_PUBLIC_PERF_RENDER_DEBUG=false
