{"openapi": "3.1.0", "info": {"title": "FOMO API", "version": "0.1.0"}, "paths": {"/api/v1/health": {"get": {"tags": ["health"], "summary": "Health Check", "description": "Health check endpoint to monitor database and Redis connectivity.", "operationId": "health_check_api_v1_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Health Check Api V1 Health Get"}}}}}}}, "/api/v1/identity/me": {"get": {"tags": ["identity"], "summary": "Get My Identity", "description": "Return the validated identity of the authenticated caller.\n\nRequires a valid Keycloak Bearer JWT.  Useful for verifying authentication\nfrom the dashboard and as a canary for OIDC configuration.", "operationId": "get_my_identity_api_v1_identity_me_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenIdentity"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/identity/admin-check": {"get": {"tags": ["identity"], "summary": "Admin Check", "description": "Return 200 if caller has admin role, 403 otherwise.", "operationId": "admin_check_api_v1_identity_admin_check_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Admin Check Api V1 Identity Admin Check Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/identity/manager-check": {"get": {"tags": ["identity"], "summary": "Manager Check", "description": "Return 200 if caller has manager or above, 403 otherwise.", "operationId": "manager_check_api_v1_identity_manager_check_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Manager Check Api V1 Identity Manager Check Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/identity/moderator-check": {"get": {"tags": ["identity"], "summary": "Moderator Check", "description": "Return 200 if caller has moderator or above, 403 otherwise.", "operationId": "moderator_check_api_v1_identity_moderator_check_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Moderator Check Api V1 Identity Moderator Check Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/identity/service-check": {"get": {"tags": ["identity"], "summary": "Service Check", "description": "Return 200 if caller has service role, 403 otherwise.", "operationId": "service_check_api_v1_identity_service_check_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Service Check Api V1 Identity Service Check Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/users/me": {"get": {"tags": ["users"], "summary": "Get My User", "description": "Return the internal FOMO user and profile for the authenticated caller.\n\nCreates the user and a default profile on first access.\nIdempotent: repeated calls with the same Keycloak subject return\nthe same record without creating duplicates.", "operationId": "get_my_user_api_v1_users_me_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserMeResponse"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/admin/users": {"get": {"tags": ["admin"], "summary": "List Users", "description": "List all FOMO users for admin management, ordered newest first.\n\nAttempts a single Keycloak batch call to populate identity_status for each\nuser.  Returns \"unknown\" for all users when KEYCLOAK_ADMIN_* is not\nconfigured or the Keycloak call fails \u2014 this is graceful degradation, not\nan error.\n\nOrphaned users (FOMO DB row exists, Keycloak identity missing) are marked\nidentity_status=\"missing_in_keycloak\".  They cannot log in because Keycloak\nwill not issue tokens for them, but they remain in the DB until an admin\nexplicitly cleans them up.  See FOMO-161 for the full orphan-handling policy.", "operationId": "list_users_api_v1_admin_users_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/UserAdminResponse"}, "type": "array", "title": "Response List Users Api V1 Admin Users Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/admin/users/{user_id}/system-role": {"patch": {"tags": ["admin"], "summary": "Update User System Role", "description": "Update a user's system_role.\n\nPrevents self-demotion: an admin cannot change their own role away from admin.\nAssigning admin role to another user and then updating your own role is the\nsupported workflow for role transfers.", "operationId": "update_user_system_role_api_v1_admin_users__user_id__system_role_patch", "security": [{"HTTPBearer": []}], "parameters": [{"name": "user_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "User Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateSystemRoleRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserAdminResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/admin/users/invite": {"post": {"tags": ["admin"], "summary": "Invite User", "description": "Create or prepare a dashboard user in Keycloak and the FOMO database.\n\nBehaviour by case:\n  A. Keycloak user absent + FOMO user absent\n     \u2192 Create both; return keycloak_created=True.\n  B. Keycloak user exists + FOMO user absent\n     \u2192 Create FOMO user mapped to existing Keycloak identity;\n       return keycloak_created=False.\n  C. FOMO user exists (by external_id) \u2192 409 Conflict.\n  D. FOMO user exists (by email, different external_id) \u2192 409 Conflict.\n\nThe created Keycloak user has UPDATE_PASSWORD as a required action, meaning\nthe user must set a password on first login.  If SMTP is configured in\nKeycloak, trigger an execute-actions-email from the Keycloak Admin UI to\nsend the user an invite link; otherwise, share the Keycloak realm login URL\nand instruct the user to use \"Forgot password\".", "operationId": "invite_user_api_v1_admin_users_invite_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteUserRequest"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteUserResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/ingestion/ingest": {"post": {"tags": ["ingestion"], "summary": "Ingest Events", "description": "Manual ingestion endpoint for pre-formatted EventIngest payloads.", "operationId": "ingest_events_api_v1_ingestion_ingest_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventIngest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestSummary"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/api/v1/ingestion/approve/{pending_id}": {"post": {"tags": ["ingestion"], "summary": "Approve Event", "operationId": "approve_eve