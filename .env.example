# ---------------------------------------------------------------------------
# Root .env.example — Docker Compose / local infrastructure
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your local values.
# NEVER commit .env or any file containing real credentials.
#
# Note: docker-compose.local.yml hardcodes safe local defaults and does NOT
# require a root .env file. This example is primarily for reference or for
# customising the main docker-compose.yml.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=fomo
POSTGRES_PASSWORD=fomo_local_password
POSTGRES_DB=fomo

# --- Application services ---
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg2://fomo:fomo_local_password@db:5432/fomo
N8N_WEBHOOK_URL=http://n8n:5678/webhook/scraper-finished

# --- Mapbox (server-side geocoding — backend only) ---
# Required for geocoding in the API container.
# Use a secret sk.* token here; keep it out of version control.
MAPBOX_ACCESS_TOKEN=your-mapbox-secret-token-here

# ---------------------------------------------------------------------------
# AI extraction (disabled by default — no cost in local/dev/CI)
# ---------------------------------------------------------------------------
# Staging/MVP: change AI_PROVIDER to deepseek and set AI_API_KEY.
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=disabled
# AI_PROVIDER=deepseek
# AI_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_API_KEY=your-deepseek-api-key-here   # alias for AI_API_KEY
# AI_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com
# AI_MAX_INPUT_CHARS=12000
# AI_MAX_OUTPUT_TOKENS=800
# AI_REQUEST_TIMEOUT_SECONDS=20

# Legacy Gemini provider (only needed when AI_PROVIDER=gemini):
# GOOGLE_API_KEY=your-google-api-key-here
